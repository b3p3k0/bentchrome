[ext_resource type="Script" path="res://resources/weapon_def.gd" id="1_def"]

[resource]
script = ExtResource("1_def")
display_name = "Leap"
kind = 2
note = "Lock-on body-check: dashes at the nearest car within 700px (straight ahead otherwise) at 1400px/s, sailing over obstacles. Connecting drains the victim's speed (0.5x, 2s) and grants 2s invulnerability; the hit itself is dash-speed ram damage."
