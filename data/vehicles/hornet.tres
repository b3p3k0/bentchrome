[resource]
script = ExtResource("1_1mr0y")
id = &"hornet"
car_name = "Hornet"
driver_name = "Jimmy Kane"
flavor = "A classic checker cab that outlived the city that painted it. Jimmy drove nights for twenty years and never once turned off the meter. The cab launches clean, corners honest, and shrugs off fender taps like Tuesday traffic. Nothing about it is special, which is exactly what makes it dependable. He swears the ice-cream clown is no relation."
special_name = "Molotov Cocktail"
special_desc = "a flaming bottle that bursts on impact. Low initial hit, then burns the target for 15 seconds. Jimmy says the recipe fell off a truck."
acceleration = 11
top_speed = 11
handling = 11
armor = 11
special_power = 11
launch = 3
