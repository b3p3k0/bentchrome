[resource]
script = ExtResource("1_pe6oe")
id = &"cyclone"
car_name = "Cyclone"
driver_name = "Mandy Joule"
flavor = "A brilliant blue open-wheeler that escaped the circuit with its engineer still in the seat. Mandy talks in lap deltas and considers walls a data source. On pavement nothing touches her; off it, the racing slicks spin like prayer wheels. Two millimeters of carbon fiber between her and the world, and she likes those odds. The pit crew quit. The car didn't notice."
special_name = "Tornado Alley"
special_desc = "the rear wheels lift and the car whips into a three-second spin, dealing damage all around and spinning out anyone caught in the funnel. Where it stops facing, nobody knows."
acceleration = 9
top_speed = 10
handling = 6
armor = 2
special_power = 8
mass = 2
primary_color = Color(0.101960786, 0.36078432, 1, 1)
accent_color = Color(0.78431374, 0.8627451, 1, 1)
special = ExtResource("2_m016v")
special_recharge_seconds = 30.0
terrain_modifiers = Array[ExtResource("3_66o0r")]([SubResource("Resource_r5b7f"), SubResource("Resource_q6fmn"), SubResource("Resource_rptkx"), SubResource("Resource_hftt0"), SubResource("Resource_inaiy")])
