special_desc = "Phase-two feel deck: applied to the controller at the transition (StatCurves only — never set_stats, which would repaint and reset HP). Speed and grip way up, armor down; the fresh HP pool is goliath_boss.gd's PHASE2_HP knob, not this armor stat."
acceleration = 9
top_speed = 11
handling = 7
armor = 7
special_power = 19
mass = 15
primary_color = Color(0.22, 0.23, 0.27, 1)
accent_color = Color(0.85, 0.45, 0.12, 1)
no_mines = true
