[resource]
script = ExtResource("1_k4hf5")
id = &"razorback"
car_name = "Razorback"
driver_name = "Big Sarge"
flavor = "A stolen military Hummer turned arena brawler. Thick plates and reinforced frame soak punishment. It lumbers into corners but holds ground like a bunker. Speed is serviceable when the road opens. Best used to herd opponents into kill lanes."
special_name = "Red Glare"
special_desc = "a forward pod dumps 20 fast rockets in a tight spread. Each hit hurts; eating the salvo is devastating. Ideal at mid-range on straight approaches."
acceleration = 3
top_speed = 6
handling = 4
armor = 8
special_power = 7
