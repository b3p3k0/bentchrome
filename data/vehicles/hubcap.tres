[resource]
script = ExtResource("1_5bin4")
id = &"hubcap"
car_name = "Hubcap"
driver_name = "Rex Goodyear"
flavor = "There is no car. Rex Goodyear strapped himself between two wheels taller than he is, bolted a machine gun to each hub mount, and called it a vehicle. The wheelbase is a single axle line, so he pivots on a coin and laughs while he does it. Armor is whatever Rex remembered to wear that morning. Nobody knows how he steers. Rex says the wheels know."
special_name = "Pulse Wave"
special_desc = "a neon-green ring of energy radiating out from Rex's body, damaging and shoving away everything it touches — hardest up close, a nudge at the rim. The kick pops him briefly off the ground."
acceleration = 15
top_speed = 7
handling = 17
special_power = 15
mass = 5
primary_color = Color(0.47843137, 0.23137255, 0.8392157, 1)
accent_color = Color(0.22352941, 1, 0.41568628, 1)
special = ExtResource("2_1q2r5")
special_recharge_seconds = 25.0
