[resource]
script = ExtResource("1_lx0hr")
id = &"splatcat"
car_name = "Splat Cat"
driver_name = "Juan Dough"
flavor = "A fast-talking courier with nine lives and unpaid parking tickets. The compact ride is quick, nimble, and streetwise. Armor sits in the middle; evasive driving is the real defense. He thrives in traffic and dirty lines. Delivery guaranteed, signature optional."
special_name = "Splat Effect"
special_desc = "on hit, the victim’s speed is cut in half immediately and capped at 50% of max for 3 seconds. Brutal for chase denial and escape setups. Best used to chain team pressure or secure pickups."
acceleration = 6
top_speed = 7
handling = 7
special_power = 8
