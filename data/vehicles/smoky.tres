[resource]
script = ExtResource("1_1uc7n")
id = &"smoky"
car_name = "Smoky"
driver_name = "Officer Richard Vepsh"
flavor = "A hard-nosed cop in a pursuit-tuned SUV. It jumps off the line and shrugs off fender benders. Mid pack at the top end and clumsy in tight chicanes. Built for ramming and zone control. Sirens on means mercy off."
special_name = "Taser"
special_desc = "auto-locks within close range for a two-second shock burst, then needs a long recovery. Deals moderate damage per second and cripples the victim’s handling while latched."
