[resource]
script = ExtResource("1_nb4ot")
id = &"coldfront"
car_name = "Coldfront"
driver_name = "Marta Laviini"
flavor = "A crimson '80s pickup wearing a yellow county snowplow like a permanent scowl. Marta plowed mountain passes for twenty winters and never once got thanked. Snow, ice, whiteout — the truck doesn't notice; asphalt manners on the worst surfaces in the game. The plow makes her wide, the payload makes her stubborn, and the handling is strictly no-hurry. Cross her lane and she'll leave you parked in a block of ice."
special_name = "Chilblain"
special_desc = "a bluish-white squall that tracks like a fire missile. Mild damage on impact, but the victim is encased in ice for 5 seconds — no driving, no shooting, just sliding to a stop while she lines up the plow."
handling = 3
armor = 7
special_power = 8
mass = 7
primary_color = Color(0.7529412, 0.09411765, 0.17254902, 1)
accent_color = Color(0.9490196, 0.75686276, 0.11764706, 1)
special = ExtResource("2_cgn21")
