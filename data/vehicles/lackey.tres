[resource]
script = ExtResource("1_stats")
id = &"lackey"
car_name = "Lackey"
driver_name = "Lackey"
flavor = "Corporate muscle in a surplus eight-wheeler. Not selectable, not sociable. The armor shrugs off everything you have — from the front. The engineers cut corners around the exhaust."
special_name = "Blaze & Bolt"
special_desc = "Stolen kit: Bumper's torch for the clinch, Smoky's taser for the chase — both barrels drain ONE magazine. And the Breach Cannon turret never stops turning. Circle behind him — the rear plating is thin."
