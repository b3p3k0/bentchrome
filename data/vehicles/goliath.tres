[gd_resource type="Resource" script_class="VehicleStats" format=3]

[ext_resource type="Script" path="res://resources/vehicle_stats.gd" id="1_stats"]

[resource]
script = ExtResource("1_stats")
id = &"goliath_cab"
car_name = "Goliath"
driver_name = "Goliath"
flavor = "The coliseum's undefeated king. A road-train tractor hauling a fortress: he keeps his distance, lets the trailer battery talk, and answers a rude approach with the grille or the tail. The plating is seamless — except where the trailer meets the cab."
special_name = "Jackknife"
special_desc = "Phase one: a broad loop, turret fire at range, a stegosaurus tail for anyone who closes. Phase two: the trailer is gone and so is his patience. Bait the charge — a missed ram leaves him seeing stars."
acceleration = 5
top_speed = 7
handling = 3
armor = 19
special_power = 19
mass = 19
primary_color = Color(0.22, 0.23, 0.27, 1)
accent_color = Color(0.85, 0.45, 0.12, 1)
no_mines = true
