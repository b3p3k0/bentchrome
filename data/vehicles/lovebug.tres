[resource]
script = ExtResource("1_jkfpl")
id = &"lovebug"
car_name = "Lovebug"
driver_name = "Moonbeam"
flavor = "A sunshine-yellow Beetle wearing flowers, peace signs, and thirty years of good vibes. Moonbeam doesn't believe in violence; she believes in consequences. The bug needs a running start — she winds up slow, then dances through corners, and famously floats across shallow water like the commercials promised. Thin panels and an air-cooled engine mean fire is her worst enemy. She'd rather disarm you than dent you."
special_name = "Chill Out, Man"
special_desc = "a glowing peace symbol that flies fast and hits soft. Zero damage, but the target's guns go offline for 3 seconds. Evaporates into glitter on impact."
acceleration = 10
handling = 11
armor = 7
special_power = 13
mass = 7
launch = 3
