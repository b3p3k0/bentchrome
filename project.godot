; Engine configuration file.
; Bent Chrome — clean-slate rebuild (Godot 4.7).
; Edited via the editor UI where possible; hand-edits kept minimal and commented.

config_version=5

[application]

config/name="Bent Chrome"
config/description="Top-down vehicular combat — clean-slate rebuild"
run/main_scene="res://levels/arena/arena.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameState="*res://game/game_state.gd"
SceneFlow="*res://game/scene_flow.gd"
Spawner="*res://game/spawner.gd"
InputRouter="*res://game/input_router.gd"
AudioDirector="*res://game/audio_director.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=false
window/stretch/mode="viewport"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.1, 0.1, 0.12, 1)
